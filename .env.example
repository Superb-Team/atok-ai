# Database Configuration
# Remote PostgreSQL Connection (Docker/Staging)
# Format: postgresql://username:password@ip_server:port/database

# NOTE: Special characters in password must be URL-encoded:
# ! = %21
# ; = %3B
# @ = %40
# # = %23
# $ = %24
# % = %25

DATABASE_URL="postgresql://username:password@localhost:5432/atok_db"

# JWT Secret (change this in production!)
JWT_SECRET=your-jwt-secret-here

# DeepInfra Configuration (backend only, not exposed to frontend)
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEEPINFRA_FALLBACK_MODELS=XiaomiMiMo/MiMo-V2.5
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# DeepInfra Whisper (transcription, uses DEEPINFRA_API_KEY above)
# Model: openai/whisper-large-v3-turbo
# No separate key needed — same DEEPINFRA_API_KEY
# Optional deployment-wide comma-separated names/domain terms. Empty by default;
# recording-specific terms entered in the UI take priority and are stored per take.
WHISPER_GLOSSARY=
# Optional mic-only comparison pass. The mixed track remains canonical.
# Enable only when you need glossary correction or hallucination arbitration.
WHISPER_DUAL_TRACK=0

# Agent API Configuration (backend only, not exposed to frontend)
# Leave empty if not using Agent API features (RAG)
AGENT_BASE_URL=
AGENT_API_KEY=

# Email Configuration (for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

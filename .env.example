# Database Configuration
# AWS RDS PostgreSQL Connection
# Format: postgresql://username:password@host:port/database

# NOTE: Special characters in password must be URL-encoded:
# ! = %21
# ; = %3B
# @ = %40
# # = %23
# $ = %24
# % = %25

DATABASE_URL=base_url_postgre

# JWT Secret (change this in production!)
JWT_SECRET=atok-ai-super-secret-jwt-key-production-2025

# Email Configuration (for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# AWS Credentials for Bedrock Integration
# Get your credentials from AWS Console: https://console.aws.amazon.com/iam/

# AWS Access Key ID
VITE_AWS_ACCESS_KEY_ID=your_access_key_id_here

# AWS Secret Access Key
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Region (e.g., ap-southeast-1, us-east-1)
VITE_AWS_REGION=ap-southeast-1

# Bedrock Model ID (Amazon Nova Pro model)
# Format: <region>.amazon.<model-name>:<version>
VITE_AWS_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
